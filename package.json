{
  "name": "vmk-website",
  "version": "1.0.0",
  "description": "Vörösmarty Mihály Könyvtár (VMK) Modernized Website Platform with Next.js 15 and Payload CMS v3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:editorial-regression": "playwright test tests/e2e/editorial-news-roundtrip.spec.ts tests/e2e/editorial-events-roundtrip.spec.ts tests/e2e/editorial-openinghours-roundtrip.spec.ts tests/e2e/editorial-pages-roundtrip.spec.ts tests/e2e/editorial-galleries-roundtrip.spec.ts tests/e2e/editorial-media-replacement-roundtrip.spec.ts --workers=1",
    "visual:oracle": "node tools/visual-oracle.mjs live",
    "visual:oracle:discover": "node tools/visual-oracle.mjs discover",
    "visual:oracle:capture": "node tools/visual-oracle.mjs capture",
    "visual:oracle:compare": "node tools/visual-oracle.mjs compare",
    "payload": "payload"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "@payloadcms/storage-s3": "^3.87.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.420.0",
    "meilisearch": "^0.38.0",
    "next": "15.4.11",
    "payload": "3.87.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
