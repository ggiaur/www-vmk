{
  "referenceBaseUrl": "https://www.vmk.hu/",
  "localBaseUrl": "http://localhost:3001/",
  "depth": 1,
  "maxRoutes": 200,
  "viewports": [
    { "name": "desktop-1440", "width": 1440, "height": 1000 },
    { "name": "mobile-390", "width": 390, "height": 844 }
  ],
  "pixelThreshold": 0,
  "maxPixelDiffPercent": 5,
  "maxHeightDiffPercent": 5,
  "minContentSimilarityPercent": 95,
  "topRegions": 8,
  "outputDir": ".visual-oracle",
  "cookieSelectors": [
    ".cc-nb-okagree",
    "button:has-text(\"Elfogad\")"
  ],
  "volatileSelectors": [
    ".cc-window",
    ".cc-revoke"
  ],
  "excludePatterns": [
    "^/admin(?:/|$)",
    "^/api(?:/|$)",
    "^/_next(?:/|$)",
    "^/sitemap(?:\\.|/|$)"
  ],
  "routeOverrides": {
    "/elerhetosegeink": "/kapcsolat",
    "/kozponti-konyvtar-1": "/reszlegek/kozponti-konyvtar",
    "/felnott-kolcsonzo-reszleg": "/reszlegek/felnott-kolcsonzo",
    "/olvasoterem": "/reszlegek/olvasoterem",
    "/pedagogiai-reszleg": "/reszlegek/pedagogia",
    "/budai-uti-tagkonyvtar": "/tagkonyvtarak/budai-ut",
    "/meszoly-geza-utcai-tagkonyvtar": "/tagkonyvtarak/meszoly-geza",
    "/szena-teri-tagkonyvtar": "/tagkonyvtarak/szena-ter",
    "/tolnai-utcai-tagkonyvtar": "/tagkonyvtarak/tolnai-ut",
    "/zsolt-utcai-tagkonyvtar": "/tagkonyvtarak/zsolt-ut",
    "/gallery": "/galeria",
    "/alapdokumentumok": "/dokumentumok"
  }
}
