{% extends 'templates/base.twig' %}

{% block content %}
    <div class="archive-adatbazis-page">
        <header class="page-hero">
            <div class="container">
                <div class="page-hero__inner" style="border: 1px solid var(--line); border-bottom: 4px solid var(--brand); box-shadow: var(--shadow-soft);">
                    <span class="eyebrow">Digitális Könyvtár</span>
                    <h1>Digitális Adatbázisok</h1>
                    <p class="page-hero__intro">Előfizetett szakirodalmi, sajtó- és e-könyv adatbázisaink gyűjteménye. Kutasson otthonról vagy a könyvtár hálózatából!</p>
                </div>
            </div>
        </header>

        <section class="section adatbazis-archive-body" style="padding-top: 3.5rem;">
            <div class="container">
                <!-- Dynamic Client Side Filter Tags -->
                <div class="database-filters-container" style="margin-bottom: 2.5rem; background: var(--surface-soft); border: 1px solid var(--line); padding: 1.5rem; border-radius: 4px; box-shadow: var(--shadow-soft);">
                    <h3 style="margin-top: 0; margin-bottom: 0.75rem; font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink);">Témakörök szűrése</h3>
                    <div class="database-filter-tags" id="db-filter-wrap" style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                        <button class="filter-tag-btn is-active" data-filter="all" style="padding: 0.45rem 1rem; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); font-weight: 700; font-size: 0.82rem; cursor: pointer; border-radius: 4px; transition: all 180ms ease;">Összes</button>
                        {% set unique_tags = [] %}
                        {% for db in adatbazisok %}
                            {% for tag in db.tags %}
                                {% if tag not in unique_tags %}
                                    {% set unique_tags = unique_tags|merge([tag]) %}
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                        
                        {% for tag in unique_tags %}
                            <button class="filter-tag-btn" data-filter="{{ tag }}" style="padding: 0.45rem 1rem; border: 1px solid var(--line); background: var(--surface); color: var(--muted); font-weight: 700; font-size: 0.82rem; cursor: pointer; border-radius: 4px; transition: all 180ms ease;">#{{ tag }}</button>
                        {% endfor %}
                    </div>
                </div>

                <!-- Database Cards Grid -->
                <div class="adatbazis-grid" id="db-cards-grid">
                    {% for db in adatbazisok %}
                        <article class="adatbazis-card" data-tags="{{ db.tags|join(',') }}" style="background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-soft); padding: 2rem 1.85rem; border-radius: 4px;">
                            <div class="adatbazis-card__header" style="margin-bottom: 1.25rem;">
                                <span class="access-badge access-badge--{{ db.access_class }}" style="align-self: flex-start; font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.3rem 0.65rem; border-radius: 3px; {% if db.access_class == 'remote' %}background: var(--brand-green); color: #fff;{% else %}background: var(--surface-muted); color: var(--ink); border: 1px solid var(--line-strong);{% endif %}">
                                    {{ db.access_type }}
                                </span>
                                <h3 style="margin: 0.5rem 0 0; font-size: 1.35rem; color: var(--ink); font-family: 'Fraunces', Georgia, serif; line-height: 1.3;">{{ db.title }}</h3>
                            </div>
                            <p class="adatbazis-card__excerpt" style="font-size: 0.92rem; color: var(--muted); line-height: 1.6; margin: 0 0 1.5rem; flex-grow: 1;">{{ db.excerpt }}</p>
                            <div class="adatbazis-card__tags" style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.5rem;">
                                {% for tag in db.tags %}
                                    <span class="db-tag" style="font-size: 0.76rem; font-weight: 600; color: var(--brand); background: var(--brand-soft); padding: 0.15rem 0.45rem; border-radius: 3px;">#{{ tag }}</span>
                                {% endfor %}
                            </div>
                            <a class="button button--primary" href="{{ db.url }}" target="_blank" rel="noopener noreferrer" style="width: 100%; text-align: center; font-size: 0.88rem; min-height: 2.8rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; box-shadow: none;">
                                Adatbázis megnyitása
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                            </a>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>
    </div>

    <!-- Client Side Dynamic Filtering Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const filterWrap = document.getElementById('db-filter-wrap');
            if (!filterWrap) return;

            const filterBtns = filterWrap.querySelectorAll('.filter-tag-btn');
            const dbCards = document.querySelectorAll('#db-cards-grid .adatbazis-card');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    // Update active button state
                    filterBtns.forEach(b => {
                        b.classList.remove('is-active');
                        b.style.borderColor = 'var(--line)';
                        b.style.background = 'var(--surface)';
                        b.style.color = 'var(--muted)';
                    });
                    
                    btn.classList.add('is-active');
                    btn.style.borderColor = 'var(--brand)';
                    btn.style.background = 'var(--brand-soft)';
                    btn.style.color = 'var(--brand)';

                    const filterValue = btn.getAttribute('data-filter');

                    dbCards.forEach(card => {
                        if (filterValue === 'all') {
                            card.style.display = 'flex';
                            card.style.animation = 'fadeInUp 300ms ease forwards';
                        } else {
                            const tags = card.getAttribute('data-tags').split(',');
                            if (tags.includes(filterValue)) {
                                card.style.display = 'flex';
                                card.style.animation = 'fadeInUp 300ms ease forwards';
                            } else {
                                card.style.display = 'none';
                            }
                        }
                    });
                });
            });

            // Set initial visual style for active 'All' button
            const activeAll = filterWrap.querySelector('.filter-tag-btn.is-active');
            if (activeAll) {
                activeAll.style.borderColor = 'var(--brand)';
                activeAll.style.background = 'var(--brand-soft)';
                activeAll.style.color = 'var(--brand)';
            }
        });
    </script>
{% endblock %}
