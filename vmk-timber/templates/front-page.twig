{% extends 'templates/base.twig' %}

{% block content %}
    <section class="hero hero--editorial">
        <div class="container">
            <div class="hero-stage">
                <article class="hero-feature">
                    {% if home.featured.lead.preview is defined and home.featured.lead.thumbnail %}
                        <a class="hero-feature__media" href="{{ home.featured.lead.link }}">
                            <img src="{{ home.featured.lead.thumbnail.src('large') }}" alt="{{ home.featured.lead.thumbnail.alt ?: home.featured.lead.title }}">
                        </a>
                    {% endif %}
                    <div class="hero-feature__overlay">
                        <div class="hero-feature__copy">
                            <span class="eyebrow">{{ home.hero.eyebrow }}</span>
                            <h1>{{ home.hero.title }}</h1>
                            <p class="hero__text">{{ home.hero.text }}</p>
                            <div class="hero-feature__actions">
                                <a class="button button--primary" href="{{ home.hero.primary_cta.url }}">{{ home.hero.primary_cta.label }}</a>
                                <a class="button button--ghost" href="{{ home.hero.secondary_cta.url }}">{{ home.hero.secondary_cta.label }}</a>
                            </div>
                            <div class="hero-feature__meta">
                                {% for stat in home.hero.stats %}
                                    <div class="hero-feature__stat">
                                        <strong>{{ stat.value }}</strong>
                                        <span>{{ stat.label }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </article>

                <aside class="hero-sidebar">
                    {% for item in home.hero.highlights %}
                        <article class="hero-link-card">
                            <h3>{{ item.title }}</h3>
                            <p>{{ item.text }}</p>
                            <a href="{{ item.url }}">Bővebben</a>
                        </article>
                    {% endfor %}

                    <article class="hero-hours-card" id="programok">
                        <span class="eyebrow">Nyitvatartás</span>
                        <p>{{ footer.hours }}</p>
                        <strong>09:00 - 19:00</strong>
                    </article>
                </aside>
            </div>

            <div class="hero-search" id="kereses" data-dual-search>
                <div class="search-tabs">
                    <button class="search-tab-btn is-active" data-search-mode="catalog" type="button">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                        Könyvtári Katalógus
                    </button>
                    <button class="search-tab-btn" data-search-mode="site" type="button">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        Honlap tartalma
                    </button>
                </div>
                <form class="search-box search-box--editorial" id="dual-search-form" role="search" method="get" action="https://katalogus.vmk.hu/opac" target="_blank">
                    <label class="screen-reader-text" for="vmk-search">Keresés</label>
                    <input id="vmk-search" type="search" name="keyword" placeholder="Írd be a könyv címét, szerzőjét vagy témáját..." required>
                    <button type="submit">Keresés</button>
                </form>
            </div>
        </div>
    </section>

    <section class="section editorial-grid" id="szolgaltatasok">
        <div class="container editorial-grid__layout">
            <div class="editorial-main">
                <div class="section-heading section-heading--compact">
                    <h2>Trendek</h2>
                </div>

                <div class="editorial-lead" data-services-tabs>
                    <aside class="editorial-lead__menu">
                        {% for item in home.services.items|slice(0, 6) %}
                            <button class="service-tab-trigger {% if loop.first %}is-active{% endif %}" data-tab-target="service-{{ loop.index }}" type="button">
                                <span class="service-tab-trigger__num">0{{ loop.index }}</span>
                                <span class="service-tab-trigger__title">{{ item.title }}</span>
                            </button>
                        {% endfor %}
                    </aside>

                    <div class="editorial-lead__panels">
                        {% for item in home.services.items|slice(0, 6) %}
                            <article class="service-tab-panel {% if loop.first %}is-active{% endif %}" id="service-{{ loop.index }}" data-tab-panel>
                                <div class="editorial-lead__content editorial-lead__content--dark">
                                    <span class="pill">Könyvtári Szolgáltatás</span>
                                    <h3>{{ item.title }}</h3>
                                    <p>{{ item.text }}</p>
                                    <a class="button button--primary" href="{{ item.url|default('#') }}">Részletek és ügyintézés</a>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                </div>

                <div class="editorial-cards">
                    {% for item in home.news.items|slice(0, 3) %}
                        <article class="editorial-card">
                            {% if item.preview is defined and item.thumbnail %}
                                <a class="editorial-card__media" href="{{ item.link }}">
                                    <img src="{{ item.thumbnail.src('medium_large') }}" alt="{{ item.thumbnail.alt ?: item.title }}">
                                </a>
                            {% endif %}
                            <div class="editorial-card__content">
                                <span class="news-card__date">
                                    {% if item.preview is defined %}
                                        {{ item.date('Y.m.d.') }}
                                    {% else %}
                                        {{ item.date }}
                                    {% endif %}
                                </span>
                                <h3>{{ item.title }}</h3>
                                <p>
                                    {% if item.preview is defined %}
                                        {{ item.preview.length(14).read_more(false) }}
                                    {% else %}
                                        {{ item.text }}
                                    {% endif %}
                                </p>
                                <a class="editorial-card__link" href="{% if item.preview is defined %}{{ item.link }}{% else %}{{ item.url }}{% endif %}">Tovább</a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>

            <aside class="editorial-sidebar" id="hirek">
                <div class="section-heading section-heading--compact">
                    <h2>{{ home.news.title }}</h2>
                </div>

                <div class="news-summary-list">
                    {% for item in home.news.items %}
                        <article class="news-summary">
                            <span class="news-card__date">
                                {% if item.preview is defined %}
                                    {{ item.date('Y.m.d.') }}
                                {% else %}
                                    {{ item.date }}
                                {% endif %}
                            </span>
                            <h3>{{ item.title }}</h3>
                            <p>
                                {% if item.preview is defined %}
                                    {{ item.preview.length(12).read_more(false) }}
                                {% else %}
                                    {{ item.text }}
                                {% endif %}
                            </p>
                            <a href="{% if item.preview is defined %}{{ item.link }}{% else %}{{ item.url }}{% endif %}">Tovább</a>
                        </article>
                    {% endfor %}
                </div>

                <section class="hours-panel-dark">
                    <h3>{{ home.hours.title }}</h3>
                    <ul class="hours-list">
                        {% for item in home.hours.items %}
                            <li>
                                <span>{{ item.label }}</span>
                                <strong>{{ item.value }}</strong>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            </aside>
        </div>
    </section>

    <section class="resource-band section" id="forrasok">
        <div class="container">
            <div class="resource-band__inner">
                <div class="section-heading section-heading--centered">
                    <span class="eyebrow eyebrow--light">Digitális Források</span>
                    <h2>Előfizetett Adatbázisok & Sajtóforrások</h2>
                    <p class="resource-band__lead">Otthonról vagy a könyvtár épületéből is elérhető elektronikus szakirodalmi tárak.</p>
                </div>
                <div class="adatbazis-grid">
                    {% for db in adatbazisok %}
                        <article class="adatbazis-card">
                            <div class="adatbazis-card__header">
                                <span class="access-badge access-badge--{{ db.access_class }}">{{ db.access_type }}</span>
                                <h3>{{ db.title }}</h3>
                            </div>
                            <p class="adatbazis-card__excerpt">{{ db.excerpt }}</p>
                            <div class="adatbazis-card__tags">
                                {% for tag in db.tags %}
                                    <span class="db-tag">#{{ tag }}</span>
                                {% endfor %}
                            </div>
                            <a class="adatbazis-card__link" href="{{ db.url }}" target="_blank" rel="noopener noreferrer">
                                Adatbázis Megnyitása
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                            </a>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    <section class="section news-gallery">
        <div class="container">
            <div class="section-heading section-heading--compact">
                <h2>Hírek és események</h2>
            </div>
            <div class="news-gallery__grid">
                {% for item in home.news.items %}
                    <article class="news-gallery__card">
                        {% if item.preview is defined and item.thumbnail %}
                            <a class="news-gallery__media" href="{{ item.link }}">
                                <img src="{{ item.thumbnail.src('large') }}" alt="{{ item.thumbnail.alt ?: item.title }}">
                            </a>
                        {% endif %}
                        <div class="news-gallery__overlay">
                            <span class="news-card__date">
                                {% if item.preview is defined %}
                                    {{ item.date('Y.m.d.') }}
                                {% else %}
                                    {{ item.date }}
                                {% endif %}
                            </span>
                            <h3>{{ item.title }}</h3>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="section tagkonyvtarak-section" id="tagkonyvtarak">
        <div class="container">
            <div class="section-heading">
                <span class="eyebrow">Helyszínek</span>
                <h2>Tagkönyvtáraink</h2>
                <p class="section-lead">Ismerje meg a városszerte elérhető fiókkönyvtárainkat!</p>
            </div>
            
            <div class="tagkonyvtarak-grid">
                {% for konyvtar in tagkonyvtarak %}
                    <article class="tagkonyvtar-card" data-hours-raw="{{ konyvtar.hours_raw }}">
                        <div class="tagkonyvtar-card__header">
                            <div class="tagkonyvtar-status-badge" data-status-label>Betöltés...</div>
                            <h3>{{ konyvtar.title }}</h3>
                        </div>
                        <div class="tagkonyvtar-card__body">
                            <p class="tagkonyvtar-card__address">
                                <strong>Cím:</strong> {{ konyvtar.address }}
                            </p>
                            <p class="tagkonyvtar-card__contact">
                                <strong>Telefon:</strong> <a href="tel:{{ konyvtar.phone|replace({' ': '', '-': ''}) }}">{{ konyvtar.phone }}</a><br>
                                <strong>E-mail:</strong> <a href="mailto:{{ konyvtar.email }}">{{ konyvtar.email }}</a>
                            </p>
                            <div class="tagkonyvtar-card__services">
                                {% for svc in konyvtar.services %}
                                    <span class="service-chip-small">{{ svc }}</span>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="tagkonyvtar-card__footer">
                            <a class="button button--ghost-dark" href="{{ konyvtar.url }}">Részletek & Térkép</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="study-banner section" id="terek">
        <div class="container">
            <article class="study-banner__inner">
                <div class="study-banner__content">
                    <span class="eyebrow">Terek és termek</span>
                    <h2>{{ home.spaces.title }}</h2>
                    <p>{{ home.spaces.text }}</p>
                    <div class="hero-feature__actions">
                        <a class="button button--primary" href="{{ home.spaces.cta.url }}">{{ home.spaces.cta.label }}</a>
                    </div>
                </div>
                <div class="study-banner__cta-bar">
                    <div>
                        <span class="eyebrow">Támogatás</span>
                        <strong>{{ home.donation.title }}</strong>
                    </div>
                    <a class="button button--light" href="{{ home.donation.cta.url }}">{{ home.donation.cta.label }}</a>
                </div>
            </article>
        </div>
    </section>
{% endblock %}
