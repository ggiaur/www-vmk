{% extends 'templates/base.twig' %}

{% block content %}

{# ═══════════════════════════════════════════════════════
   1.  HERO KERESŐSÁV  –  Deichman: a keresés a főhős
   ═══════════════════════════════════════════════════════ #}
<section class="vmk-hero-search" id="kereses" aria-label="Katalóguskeresés">
    <div class="vmk-hero-search__inner">
        <div class="container">
            <div class="vmk-hero-search__heading">
                <h1>Mit keresel ma?</h1>
                <p>Könyvek, folyóiratok, e-könyvek és digitális tartalmak – Székesfehérvár és Fejér megye legnagyobb könyvtárában</p>
            </div>
            <form class="vmk-search-form"
                  method="get"
                  action="http://tlwww.vmk.hu/tlwww"
                  target="_blank"
                  role="search">
                <div class="vmk-search-form__row">
                    <div class="vmk-search-form__tabs">
                        <label class="vmk-search-tab">
                            <input type="radio" name="searchfield" value="ALL" checked>
                            <span>Mindenhol</span>
                        </label>
                        <label class="vmk-search-tab">
                            <input type="radio" name="searchfield" value="TITLE">
                            <span>Cím</span>
                        </label>
                        <label class="vmk-search-tab">
                            <input type="radio" name="searchfield" value="AUTHOR">
                            <span>Szerző</span>
                        </label>
                        <label class="vmk-search-tab">
                            <input type="radio" name="searchfield" value="SUBJECT">
                            <span>Téma</span>
                        </label>
                    </div>
                </div>
                <div class="vmk-search-form__bar">
                    <label class="screen-reader-text" for="vmk-q">Keresési kifejezés</label>
                    <input id="vmk-q"
                           class="vmk-search-form__input"
                           type="search"
                           name="searcharg"
                           placeholder="Írd be a könyv címét, szerzőjét vagy témáját…"
                           autocomplete="off"
                           spellcheck="false">
                    <button class="vmk-search-form__btn" type="submit">
                        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                        Keresés
                    </button>
                </div>
                <p class="vmk-search-form__hint">
                    Keresés az online katalógusban ·
                    <a href="http://tlwww.vmk.hu/tlwww/olvall.htm" target="_blank" rel="noopener">Olvasói bejelentkezés</a> ·
                    <a href="{{ footer.catalog_url }}" target="_blank" rel="noopener">Beiratkozás online</a>
                </p>
            </form>
        </div>
    </div>
</section>

{# ═══════════════════════════════════════════════════════
   2.  KIEMELT BILLBOARD  –  Deichman: billboard-mini
       2/3 kép  +  1/3 szöveges kártya
   ═══════════════════════════════════════════════════════ #}
{% set fallback_imgs = [
    'https://images.unsplash.com/photo-1507842217343-583bb7270b66?auto=format&fit=crop&w=1600&q=80',
    'https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?auto=format&fit=crop&w=1600&q=80',
    'https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=1600&q=80',
    'https://images.unsplash.com/photo-1521587760476-6c12a4b040da?auto=format&fit=crop&w=1600&q=80',
    'https://images.unsplash.com/photo-1568667256549-094345857637?auto=format&fit=crop&w=1600&q=80',
    'https://images.unsplash.com/photo-1495446815901-a7297e633e8d?auto=format&fit=crop&w=1600&q=80'
] %}

<section class="vmk-billboard" aria-label="Kiemelt tartalom">
    <div class="vmk-billboard__grid">
        <div class="vmk-billboard__image"
             style="background-image: url('{{ fallback_imgs[0] }}')">
            {% if home.featured.lead.thumbnail is defined and home.featured.lead.thumbnail %}
                <img src="{{ home.featured.lead.thumbnail.src('large') }}"
                     alt="{{ home.featured.lead.title }}"
                     loading="eager">
            {% endif %}
        </div>
        <article class="vmk-billboard__card">
            <p class="vmk-billboard__eyebrow">Kiemelten ajánljuk</p>
            <h2 class="vmk-billboard__title">{{ home.featured.lead.title }}</h2>
            <div class="vmk-billboard__text">
                <p>{{ home.featured.lead.text }}</p>
            </div>
            <a class="vmk-btn vmk-btn--primary" href="{{ home.featured.lead.url|default('#esemenyek') }}">
                Részletek megtekintése
            </a>
            <div class="vmk-billboard__meta">
                <span>
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {{ footer.hours }}
                </span>
                <span>
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    {{ footer.address }}
                </span>
            </div>
        </article>
    </div>
</section>

{# ═══════════════════════════════════════════════════════
   3.  AKTUÁLIS HÍREK  –  Deichman: news-grid (3 kártya)
   ═══════════════════════════════════════════════════════ #}
<section class="vmk-section" id="hirek" aria-labelledby="hirek-heading">
    <div class="container">
        <div class="vmk-section-header">
            <h2 id="hirek-heading" class="vmk-section-title">Aktuális hírek</h2>
            <a class="vmk-see-all" href="/hirek">
                Hírek archívuma
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>

        <ul class="vmk-news-grid">
            {% for item in home.news.items|slice(0, 3) %}
            {% set img_fallback = fallback_imgs[loop.index % fallback_imgs|length] %}
            <li>
                <article class="vmk-news-card">
                    <a class="vmk-news-card__image-link" href="{% if item.link is defined %}{{ item.link }}{% else %}{{ item.url|default('#') }}{% endif %}" tabindex="-1" aria-hidden="true">
                        <div class="vmk-news-card__image"
                             style="background-image: url('{{ img_fallback }}')">
                            {% if item.thumbnail is defined and item.thumbnail %}
                                <img src="{{ item.thumbnail.src('large') }}"
                                     alt="{{ item.thumbnail.alt|default(item.title) }}"
                                     loading="lazy">
                            {% endif %}
                        </div>
                    </a>
                    <div class="vmk-news-card__tags">
                        <span class="vmk-tag">Hír</span>
                        {% if item.categories is defined %}
                            {% for cat in item.categories|slice(0,2) %}
                                <span class="vmk-tag">{{ cat.name }}</span>
                            {% endfor %}
                        {% endif %}
                    </div>
                    <h3 class="vmk-news-card__title">
                        <a href="{% if item.link is defined %}{{ item.link }}{% else %}{{ item.url|default('#') }}{% endif %}">
                            {{ item.title }}
                        </a>
                    </h3>
                    <p class="vmk-news-card__excerpt">
                        {% if item.preview is defined %}{{ item.preview.length(18).read_more(false) }}{% else %}{{ item.text }}{% endif %}
                    </p>
                </article>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

{# ═══════════════════════════════════════════════════════
   4.  KÖNYVTÁRI SZOLGÁLTATÁSOK  –  2 kártyás feature
   ═══════════════════════════════════════════════════════ #}
<section class="vmk-section vmk-features-section" aria-labelledby="features-heading">
    <div class="container">
        <div class="vmk-section-header">
            <h2 id="features-heading" class="vmk-section-title">Szolgáltatásaink</h2>
        </div>
        <div class="vmk-features-grid">
            {% for item in home.services.items|slice(0, 4) %}
            {% set feat_colors = ['#e8380d', '#1a1917', '#2d7a4f', '#1a5ca8'] %}
            <article class="vmk-feature-card">
                <div class="vmk-feature-card__bar" style="background: {{ feat_colors[loop.index0 % 4] }}"></div>
                <div class="vmk-feature-card__body">
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.text }}</p>
                    <a class="vmk-feature-card__link" href="{{ item.url|default('#') }}">
                        Bővebben
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

{# ═══════════════════════════════════════════════════════
   5.  BILLBOARD MIDI  –  Deichman: kép + szövegdoboz
       (Tagkönyvtárak / Terek banner)
   ═══════════════════════════════════════════════════════ #}
<section class="vmk-billboard-midi" id="terek">
    <div class="container">
        <div class="vmk-billboard-midi__inner">
            <div class="vmk-billboard-midi__image"
                 style="background-image: url('{{ fallback_imgs[3] }}')">
            </div>
            <div class="vmk-billboard-midi__box">
                <p class="vmk-billboard-midi__eyebrow">Terek és termek</p>
                <h2>{{ home.spaces.title }}</h2>
                <p>{{ home.spaces.text }}</p>
                <a class="vmk-btn vmk-btn--primary" href="{{ home.spaces.cta.url }}">
                    {{ home.spaces.cta.label }}
                </a>
            </div>
        </div>
    </div>
</section>

{# ═══════════════════════════════════════════════════════
   6.  KÖZELGŐ ESEMÉNYEK  –  Deichman: event-grid
       4 kártya, piros dátum-badge bal felső sarokban
   ═══════════════════════════════════════════════════════ #}
<section class="vmk-section" id="esemenyek" aria-labelledby="esemenyek-heading">
    <div class="container">
        <div class="vmk-section-header">
            <h2 id="esemenyek-heading" class="vmk-section-title">Közelgő eseményeink</h2>
            <a class="vmk-see-all" href="/esemenyek">
                Összes esemény
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>

        <ul class="vmk-event-grid">
            {% set event_types = ['Irodalmi est', 'Gyermekprogram', 'Kiállítás', 'Workshop', 'Közösségi', 'Előadás'] %}
            {% for item in home.news.items|slice(0, 4) %}
            {% set eimg = fallback_imgs[(loop.index + 1) % fallback_imgs|length] %}
            <li>
                <article class="vmk-event-card">
                    <a class="vmk-event-card__image-wrap"
                       href="{% if item.link is defined %}{{ item.link }}{% else %}{{ item.url|default('#') }}{% endif %}"
                       tabindex="-1" aria-hidden="true">
                        <div class="vmk-event-card__image"
                             style="background-image: url('{{ eimg }}')">
                            {% if item.thumbnail is defined and item.thumbnail %}
                                <img src="{{ item.thumbnail.src('medium_large') }}"
                                     alt="{{ item.thumbnail.alt|default(item.title) }}"
                                     loading="lazy">
                            {% endif %}
                        </div>
                        <div class="vmk-date-badge" aria-hidden="true">
                            <span class="vmk-date-badge__day">
                                {% if item.date is defined %}{{ item.date('d') }}{% else %}{{ 'now'|date('d') }}{% endif %}
                            </span>
                            <span class="vmk-date-badge__month">
                                {% if item.date is defined %}{{ item.date('M') }}{% else %}{{ 'now'|date('M') }}{% endif %}
                            </span>
                        </div>
                    </a>
                    <p class="vmk-event-card__type">{{ event_types[loop.index0 % 6] }}</p>
                    <h3 class="vmk-event-card__title">
                        <a href="{% if item.link is defined %}{{ item.link }}{% else %}{{ item.url|default('#') }}{% endif %}">
                            {{ item.title }}
                        </a>
                    </h3>
                    <div class="vmk-event-card__meta">
                        <time>
                            {% if item.date is defined %}{{ item.date('Y. F j.') }}{% endif %}
                        </time>
                        <a class="vmk-event-card__loc" href="/tagkonyvtarak">
                            Vörösmarty Mihály Könyvtár
                        </a>
                    </div>
                </article>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

{# ═══════════════════════════════════════════════════════
   7.  DIGITÁLIS ADATBÁZISOK  –  sötét gradient sáv
   ═══════════════════════════════════════════════════════ #}
<section class="vmk-databases" id="forrasok" aria-labelledby="db-heading">
    <div class="container">
        <div class="vmk-section-header vmk-section-header--light">
            <div>
                <p class="vmk-databases__eyebrow">Digitális Források</p>
                <h2 id="db-heading" class="vmk-section-title vmk-section-title--light">Előfizetett adatbázisok</h2>
                <p class="vmk-databases__lead">Otthonról vagy a könyvtárban elérhető elektronikus gyűjtemények, szakirodalmi tárak.</p>
            </div>
        </div>
        <div class="vmk-db-grid">
            {% for db in adatbazisok %}
            <article class="vmk-db-card">
                <div class="vmk-db-card__head">
                    <span class="vmk-access-badge vmk-access-badge--{{ db.access_class }}">{{ db.access_type }}</span>
                    <h3>{{ db.title }}</h3>
                </div>
                <p>{{ db.excerpt }}</p>
                <div class="vmk-db-card__tags">
                    {% for tag in db.tags %}<span>#{{ tag }}</span>{% endfor %}
                </div>
                <a class="vmk-db-card__link"
                   href="{{ db.url }}"
                   target="_blank" rel="noopener noreferrer">
                    Megnyitás
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

{# ═══════════════════════════════════════════════════════
   8.  TAGKÖNYVTÁRAK  –  kártya grid
   ═══════════════════════════════════════════════════════ #}
<section class="vmk-section vmk-branches" id="tagkonyvtarak" aria-labelledby="branches-heading">
    <div class="container">
        <div class="vmk-section-header">
            <div>
                <p class="vmk-eyebrow">Helyszíneink</p>
                <h2 id="branches-heading" class="vmk-section-title">Tagkönyvtáraink</h2>
            </div>
            <a class="vmk-see-all" href="/tagkonyvtarak">
                Összes helyszín
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>
        <div class="vmk-branches-grid">
            {% for k in tagkonyvtarak %}
            <article class="vmk-branch-card">
                <div class="vmk-branch-card__header">
                    <h3>{{ k.title }}</h3>
                    <span class="vmk-status-dot" data-hours-raw="{{ k.hours_raw }}" title="Nyitvatartás ellenőrzése..."></span>
                </div>
                <p class="vmk-branch-card__address">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    {{ k.address }}
                </p>
                <div class="vmk-branch-card__contacts">
                    <a href="tel:{{ k.phone|replace({' ': '', '-': ''}) }}">{{ k.phone }}</a>
                    <a href="mailto:{{ k.email }}">{{ k.email }}</a>
                </div>
                <div class="vmk-branch-card__services">
                    {% for svc in k.services %}
                        <span>{{ svc }}</span>
                    {% endfor %}
                </div>
                <a class="vmk-branch-card__link" href="{{ k.url }}">
                    Részletek és térkép →
                </a>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

{# ═══════════════════════════════════════════════════════
   9.  TANULMÁNYI TERMI BANNER  –  Deichman: billboard-midi (alsó)
   ═══════════════════════════════════════════════════════ #}
<section class="vmk-study-banner" aria-label="Adó 1% és támogatás">
    <div class="container">
        <div class="vmk-study-banner__inner">
            <div class="vmk-study-banner__image"
                 style="background-image: url('{{ fallback_imgs[4] }}')">
            </div>
            <div class="vmk-study-banner__content">
                <p class="vmk-eyebrow vmk-eyebrow--light">Támogatás</p>
                <h2>{{ home.donation.title }}</h2>
                <p>{{ home.donation.text }}</p>
                <a class="vmk-btn vmk-btn--outline-light" href="{{ home.donation.cta.url }}">
                    {{ home.donation.cta.label }}
                </a>
            </div>
        </div>
    </div>
</section>

{% endblock %}
