{% extends 'templates/base.twig' %}

{% block content %}

    {# ── HERO BILLBOARD ─────────────────────────────────── #}
    <section class="hero">
        <div class="hero-billboard">
            <div class="hero-billboard__image">
                {% if home.featured.lead.preview is defined and home.featured.lead.thumbnail %}
                    <img src="{{ home.featured.lead.thumbnail.src('large') }}"
                         alt="{{ home.featured.lead.thumbnail.alt ?: home.featured.lead.title }}"
                         loading="eager">
                {% endif %}
                <div class="hero-billboard__overlay"></div>
            </div>
            <div class="hero-billboard__content">
                <p class="hero-billboard__eyebrow">{{ home.hero.eyebrow }}</p>
                <h1 class="hero-billboard__title">{{ home.hero.title }}</h1>
                <p class="hero-billboard__text">{{ home.hero.text }}</p>
                <div class="hero-billboard__actions">
                    <a class="button button--primary" href="{{ home.hero.primary_cta.url }}">
                        {{ home.hero.primary_cta.label }}
                    </a>
                    <a class="button button--outline" href="{{ home.hero.secondary_cta.url }}">
                        {{ home.hero.secondary_cta.label }}
                    </a>
                </div>
                {% if home.hero.stats %}
                <div class="hero-billboard__stats">
                    {% for stat in home.hero.stats %}
                        <div class="hero-stat">
                            <strong>{{ stat.value }}</strong>
                            <span>{{ stat.label }}</span>
                        </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>

        {# Search bar #}
        <div class="hero-search" id="kereses" data-dual-search>
            <div class="container">
                <div class="search-tabs">
                    <button class="search-tab-btn is-active" data-search-mode="catalog" type="button">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                        Könyvtári Katalógus
                    </button>
                    <button class="search-tab-btn" data-search-mode="site" type="button">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        Honlap tartalma
                    </button>
                </div>
                <form class="search-box search-box--editorial" id="dual-search-form" role="search" method="get" action="https://katalogus.vmk.hu/opac" target="_blank">
                    <label class="screen-reader-text" for="vmk-search">Keresés</label>
                    <input id="vmk-search" type="search" name="keyword" placeholder="Írd be a könyv címét, szerzőjét vagy témáját..." required>
                    <button type="submit">Keresés</button>
                </form>
            </div>
        </div>

        {# Right sidebar: highlights + hours #}
        <aside class="hero-sidebar" style="display:none" id="hero-highlights">
            {% for item in home.hero.highlights %}
                <article class="hero-link-card">
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.text }}</p>
                    <a href="{{ item.url }}">Bővebben</a>
                </article>
            {% endfor %}
            <article class="hero-hours-card">
                <span class="eyebrow">Nyitvatartás</span>
                <p>{{ footer.hours }}</p>
                <strong>09:00 – 19:00</strong>
            </article>
        </aside>
    </section>

    {# ── HÍREK & ESEMÉNYEK – editorial grid ─────────────── #}
    <section class="section editorial-grid" id="szolgaltatasok">
        <div class="container editorial-grid__layout">
            <div class="editorial-main">

                {# Section heading: Trendek / Szolgáltatások #}
                <div class="section-heading section-heading--compact">
                    <h2>Trendek</h2>
                </div>

                {# Service tabs #}
                <div class="editorial-lead" data-services-tabs>
                    <aside class="editorial-lead__menu">
                        {% for item in home.services.items|slice(0, 6) %}
                            <button class="service-tab-trigger {% if loop.first %}is-active{% endif %}"
                                    data-tab-target="service-{{ loop.index }}" type="button">
                                <span class="service-tab-trigger__num">0{{ loop.index }}</span>
                                <span class="service-tab-trigger__title">{{ item.title }}</span>
                            </button>
                        {% endfor %}
                    </aside>
                    <div class="editorial-lead__panels">
                        {% for item in home.services.items|slice(0, 6) %}
                            <article class="service-tab-panel {% if loop.first %}is-active{% endif %}"
                                     id="service-{{ loop.index }}" data-tab-panel>
                                <div class="editorial-lead__content editorial-lead__content--dark">
                                    <span class="pill">Könyvtári Szolgáltatás</span>
                                    <h3>{{ item.title }}</h3>
                                    <p>{{ item.text }}</p>
                                    <a class="button button--ghost" href="{{ item.url|default('#') }}">Részletek és ügyintézés</a>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                </div>

                {# News cards #}
                <div class="editorial-cards" style="margin-top: 1.5rem;">
                    {% for item in home.news.items|slice(0, 3) %}
                        <article class="editorial-card">
                            {% if item.preview is defined and item.thumbnail %}
                                <a class="editorial-card__media" href="{{ item.link }}">
                                    <img src="{{ item.thumbnail.src('medium_large') }}"
                                         alt="{{ item.thumbnail.alt ?: item.title }}"
                                         loading="lazy">
                                </a>
                            {% endif %}
                            <div class="editorial-card__content">
                                <span class="news-card__date">
                                    {% if item.preview is defined %}{{ item.date('Y.m.d.') }}{% else %}{{ item.date }}{% endif %}
                                </span>
                                <h3>{{ item.title }}</h3>
                                <p>
                                    {% if item.preview is defined %}{{ item.preview.length(14).read_more(false) }}{% else %}{{ item.text }}{% endif %}
                                </p>
                                <a class="editorial-card__link" href="{% if item.preview is defined %}{{ item.link }}{% else %}{{ item.url }}{% endif %}">
                                    Tovább →
                                </a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>

            {# Sidebar: hírek + nyitvatartás #}
            <aside class="editorial-sidebar" id="hirek">
                <div class="section-heading section-heading--compact">
                    <h2>{{ home.news.title }}</h2>
                </div>
                <div class="news-summary-list">
                    {% for item in home.news.items %}
                        <article class="news-summary">
                            <span class="news-card__date">
                                {% if item.preview is defined %}{{ item.date('Y.m.d.') }}{% else %}{{ item.date }}{% endif %}
                            </span>
                            <h3>{{ item.title }}</h3>
                            <p>
                                {% if item.preview is defined %}{{ item.preview.length(12).read_more(false) }}{% else %}{{ item.text }}{% endif %}
                            </p>
                            <a href="{% if item.preview is defined %}{{ item.link }}{% else %}{{ item.url }}{% endif %}">Tovább →</a>
                        </article>
                    {% endfor %}
                </div>
                <section class="hours-panel-dark">
                    <h3>{{ home.hours.title }}</h3>
                    <ul class="hours-list">
                        {% for item in home.hours.items %}
                            <li>
                                <span>{{ item.label }}</span>
                                <strong>{{ item.value }}</strong>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            </aside>
        </div>
    </section>

    {# ── AKTUÁLIS HÍREK – news-grid (Deichman style) ─────── #}
    <section class="section" id="aktualis">
        <div class="container">
            <div class="section-heading">
                <h2>Aktuális hírek és események</h2>
                <a class="see-all-link" href="/hirek">
                    Összes hír
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>
            <div class="news-grid">
                {% for item in home.news.items|slice(0, 3) %}
                    <article class="news-card">
                        <div class="news-card__image">
                            {% if item.preview is defined and item.thumbnail %}
                                <a href="{{ item.link }}">
                                    <img src="{{ item.thumbnail.src('large') }}"
                                         alt="{{ item.thumbnail.alt ?: item.title }}"
                                         loading="lazy">
                                </a>
                            {% else %}
                                <div style="width:100%;height:100%;background:var(--surface-alt);display:grid;place-items:center;">
                                    <svg width="40" height="40" fill="none" stroke="#c8c4c0" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                                </div>
                            {% endif %}
                        </div>
                        <div class="news-card__tags">
                            <span class="news-card__tag">Hír</span>
                        </div>
                        <h3 class="news-card__title">
                            <a href="{% if item.preview is defined %}{{ item.link }}{% else %}{{ item.url|default('#') }}{% endif %}">
                                {{ item.title }}
                            </a>
                        </h3>
                        <p class="news-card__excerpt">
                            {% if item.preview is defined %}{{ item.preview.length(16).read_more(false) }}{% else %}{{ item.text }}{% endif %}
                        </p>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ── KÖZELGŐ ESEMÉNYEK (Deichman event-grid) ─────────── #}
    <section class="section" id="esemenyek">
        <div class="container">
            <div class="section-heading">
                <h2>Közelgő eseményeink</h2>
                <a class="see-all-link" href="/esemenyek">
                    Összes esemény
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>
            <div class="event-grid">
                <ul class="event-grid__items">
                    {% set event_categories = ['Irodalmi est', 'Gyermekfoglalkozás', 'Kiállítás', 'Workshop'] %}
                    {% set event_types = ['Közösségi program', 'Gyerekprogram', 'Kulturális', 'Oktatás'] %}
                    {% for item in home.news.items|slice(0, 4) %}
                        <li>
                            <article class="event-card">
                                <div class="event-card__image-wrap">
                                    {% if item.preview is defined and item.thumbnail %}
                                        <img class="event-card__image"
                                             src="{{ item.thumbnail.src('medium_large') }}"
                                             alt="{{ item.thumbnail.alt ?: item.title }}"
                                             loading="lazy">
                                    {% else %}
                                        <div style="width:100%;height:100%;background:var(--surface-alt);"></div>
                                    {% endif %}
                                    <div class="date-badge">
                                        <span class="date-badge__day">
                                            {% if item.preview is defined %}{{ item.date('d') }}{% else %}{{ 'now'|date('d') }}{% endif %}
                                        </span>
                                        <span class="date-badge__month">
                                            {% if item.preview is defined %}{{ item.date('M') }}{% else %}{{ 'now'|date('M') }}{% endif %}
                                        </span>
                                    </div>
                                </div>
                                <p class="event-card__type">{{ event_types[loop.index0 % 4] }}</p>
                                <a class="event-card__title" href="{% if item.preview is defined %}{{ item.link }}{% else %}{{ item.url|default('#') }}{% endif %}">
                                    {{ item.title }}
                                </a>
                                <div class="event-card__meta">
                                    <small>
                                        {% if item.preview is defined %}{{ item.date('Y.m.d.') }}{% else %}{{ item.date }}{% endif %}
                                    </small>
                                    <a class="event-card__location" href="/tagkonyvtarak">Vörösmarty Mihály Könyvtár</a>
                                </div>
                            </article>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </section>

    {# ── DIGITÁLIS ADATBÁZISOK ───────────────────────────── #}
    <section class="section resource-band" id="forrasok">
        <div class="container">
            <div class="resource-band__inner">
                <div class="section-heading section-heading--centered">
                    <span class="eyebrow" style="color:rgba(255,255,255,0.8)">Digitális Források</span>
                    <h2>Előfizetett Adatbázisok &amp; Sajtóforrások</h2>
                    <p class="resource-band__lead">Otthonról vagy a könyvtár épületéből is elérhető elektronikus szakirodalmi tárak.</p>
                </div>
                <div class="adatbazis-grid">
                    {% for db in adatbazisok %}
                        <article class="adatbazis-card">
                            <div class="adatbazis-card__header">
                                <span class="access-badge access-badge--{{ db.access_class }}">{{ db.access_type }}</span>
                                <h3>{{ db.title }}</h3>
                            </div>
                            <p class="adatbazis-card__excerpt">{{ db.excerpt }}</p>
                            <div class="adatbazis-card__tags">
                                {% for tag in db.tags %}
                                    <span class="db-tag">#{{ tag }}</span>
                                {% endfor %}
                            </div>
                            <a class="adatbazis-card__link" href="{{ db.url }}" target="_blank" rel="noopener noreferrer">
                                Megnyitás
                                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                            </a>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    {# ── TAGKÖNYVTÁRAK ───────────────────────────────────── #}
    <section class="section tagkonyvtarak-section" id="tagkonyvtarak">
        <div class="container">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Helyszínek</span>
                    <h2>Tagkönyvtáraink</h2>
                    <p class="section-lead">Ismerje meg a városszerte elérhető fiókkönyvtárainkat!</p>
                </div>
                <a class="see-all-link" href="/tagkonyvtarak">
                    Mind megtekintése
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>
            <div class="tagkonyvtarak-grid">
                {% for konyvtar in tagkonyvtarak %}
                    <article class="tagkonyvtar-card" data-hours-raw="{{ konyvtar.hours_raw }}">
                        <div class="tagkonyvtar-card__header">
                            <h3>{{ konyvtar.title }}</h3>
                            <div class="tagkonyvtar-status-badge" data-status-label>Betöltés...</div>
                        </div>
                        <div class="tagkonyvtar-card__body">
                            <p class="tagkonyvtar-card__address">
                                <strong>Cím:</strong> {{ konyvtar.address }}
                            </p>
                            <p class="tagkonyvtar-card__contact">
                                <strong>Tel:</strong> <a href="tel:{{ konyvtar.phone|replace({' ': '', '-': ''}) }}">{{ konyvtar.phone }}</a><br>
                                <strong>E-mail:</strong> <a href="mailto:{{ konyvtar.email }}">{{ konyvtar.email }}</a>
                            </p>
                            <div class="tagkonyvtar-card__services">
                                {% for svc in konyvtar.services %}
                                    <span class="service-chip-small">{{ svc }}</span>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="tagkonyvtar-card__footer">
                            <a class="button--ghost-dark" href="{{ konyvtar.url }}">Részletek &amp; Térkép</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ── BILLBOARD: Terek és termek ──────────────────────── #}
    <section class="section" id="terek">
        <div class="container">
            <article class="study-banner__inner">
                <div class="study-banner__content">
                    <span class="eyebrow">Terek és termek</span>
                    <h2>{{ home.spaces.title }}</h2>
                    <p>{{ home.spaces.text }}</p>
                    <a class="button button--ghost" href="{{ home.spaces.cta.url }}">{{ home.spaces.cta.label }}</a>
                </div>
                <div class="study-banner__cta-bar">
                    <div>
                        <span class="eyebrow" style="color:rgba(255,255,255,0.8)">Támogatás</span>
                        <strong>{{ home.donation.title }}</strong>
                    </div>
                    <a class="button--light" href="{{ home.donation.cta.url }}">{{ home.donation.cta.label }}</a>
                </div>
            </article>
        </div>
    </section>

{% endblock %}
