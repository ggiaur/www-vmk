{% extends 'templates/base.twig' %}

{% block content %}
    <article class="single-tagkonyvtar-post post-entry">
        <header class="page-hero">
            <div class="container">
                <div class="page-hero__inner">
                    <span class="eyebrow">Tagkönyvtár részletek</span>
                    <h1>{{ post.title }}</h1>
                    <p class="page-hero__intro">{{ post.excerpt|default('A Vörösmarty Mihály Könyvtár kiemelt városi szolgáltató helyszíne.') }}</p>
                </div>
            </div>
        </header>

        <section class="section tagkonyvtar-detail-body">
            <div class="container">
                <div class="editorial-grid__layout">
                    <div class="editorial-main content-card">
                        {% if post.thumbnail %}
                            <div class="entry-hero-media" style="margin-bottom: 2rem; box-shadow: var(--shadow-soft);">
                                <img src="{{ post.thumbnail.src('large') }}" alt="{{ post.thumbnail.alt ?: post.title }}" style="width:100%; border-radius: 4px;">
                            </div>
                        {% endif %}

                        <div class="entry-content">
                            <h2>A könyvtárról</h2>
                            {{ post.content|default('<p>Ez a fiókkönyvtárunk a város lakóinak kulturális és közösségi találkozóhelye. Széles könyvkínálattal, csendes olvasósarokkal, internethasználattal és izgalmas rendezvényekkel várjuk látogatóinkat.</p>')|raw }}
                            
                            <h3 style="margin-top: 2rem;">Elérhető Szolgáltatások</h3>
                            <div class="tagkonyvtar-card__services" style="margin-top: 1rem; gap: 0.6rem;">
                                {% for svc in post.meta('_vmk_services')|default(['Kölcsönzés', 'Helyben olvasás', 'Ingyenes Wifi', 'Fénymásolás és Szkennelés', 'Közösségi események']) %}
                                    <span class="service-chip-small" style="font-size: 0.82rem; padding: 0.35rem 0.75rem; background: var(--surface-muted); color: var(--ink); font-weight: 700;">{{ svc }}</span>
                                {% endfor %}
                            </div>
                        </div>

                        {% if post.meta('_vmk_map_embed') or post.meta('map_embed') %}
                            <div class="tagkonyvtar-map-wrap" style="margin-top: 3rem;">
                                <h3 style="margin-bottom: 1rem;">Térkép & Megközelíthetőség</h3>
                                <div class="map-iframe-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow-soft);">
                                    <iframe src="{{ post.meta('_vmk_map_embed')|default(post.meta('map_embed')) }}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" allowfullscreen="" loading="lazy"></iframe>
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    <aside class="editorial-sidebar">
                        <section class="hours-panel-dark" style="border-radius: 4px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-bottom: 1rem;">
                                <h3 style="margin: 0;">Nyitvatartás</h3>
                                <div class="tagkonyvtar-status-badge is-open" id="detail-status-badge" style="font-size: 0.72rem; padding: 0.3rem 0.7rem; font-weight: 800;">NYITVA</div>
                            </div>
                            
                            <ul class="hours-list" style="gap: 0.75rem;">
                                {% set hours_list = post.meta('_vmk_hours_list')|default({
                                    'Hétfő': '09:00 - 19:00',
                                    'Kedd': '09:00 - 19:00',
                                    'Szerda': '09:00 - 19:00',
                                    'Csütörtök': '09:00 - 19:00',
                                    'Péntek': '09:00 - 19:00',
                                    'Szombat': '09:00 - 16:00',
                                    'Vasárnap': 'Zárva'
                                }) %}
                                {% for day, hours in hours_list %}
                                    <li style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.04); padding-bottom: 0.5rem; font-size: 0.92rem;">
                                        <span style="color: rgba(255,255,255,0.72);">{{ day }}</span>
                                        <strong>{{ hours }}</strong>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>

                        <section class="content-card" style="border: 1px solid var(--line); border-radius: 4px;">
                            <h3 style="margin-top: 0; border-bottom: 1px solid var(--line); padding-bottom: 0.75rem; margin-bottom: 1rem; font-size: 1.15rem;">Kapcsolatfelvétel</h3>
                            <p style="font-size: 0.92rem; line-height: 1.6; margin-bottom: 1.25rem;">Ha kérdése van a kölcsönzéssel vagy szolgáltatásainkkal kapcsolatban, forduljon hozzánk bizalommal!</p>
                            <p style="font-size: 0.92rem; margin: 0.5rem 0;">
                                <strong>Cím:</strong><br>
                                <span style="color: var(--muted);">{{ post.meta('_vmk_address')|default('8000 Székesfehérvár, Bartók Béla tér 1.') }}</span>
                            </p>
                            <p style="font-size: 0.92rem; margin: 0.5rem 0;">
                                <strong>Telefon:</strong><br>
                                <a href="tel:{{ post.meta('_vmk_phone')|default('+36 22 312 684')|replace({' ': '', '-': ''}) }}" style="color: var(--brand); font-weight: 700;">{{ post.meta('_vmk_phone')|default('+36 22 312 684') }}</a>
                            </p>
                            <p style="font-size: 0.92rem; margin: 0.5rem 0;">
                                <strong>E-mail:</strong><br>
                                <a href="mailto:{{ post.meta('_vmk_email')|default('info@vmk.hu') }}" style="color: var(--brand); font-weight: 700;">{{ post.meta('_vmk_email')|default('info@vmk.hu') }}</a>
                            </p>
                            <a class="button button--primary" href="#kapcsolat" style="width: 100%; text-align: center; margin-top: 1rem; font-size: 0.88rem; min-height: 2.8rem; display: inline-flex; align-items: center; justify-content: center;">Üzenet küldése</a>
                        </section>
                    </aside>
                </div>
            </div>
        </section>
    </article>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const badge = document.getElementById('detail-status-badge');
            if (!badge) return;

            // Simple details open hours parser
            const daysMap = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            const now = new Date();
            const currentDayStr = daysMap[now.getDay()];
            const currentMin = now.getHours() * 60 + now.getMinutes();

            // Fallback raw hours matching the mock data details
            const hoursRaw = "{{ post.meta('_vmk_hours_raw')|default('Mon:09:00-19:00,Tue:09:00-19:00,Wed:09:00-19:00,Thu:09:00-19:00,Fri:09:00-19:00,Sat:09:00-16:00,Sun:closed') }}";
            const daysData = hoursRaw.split(',');
            let daySchedule = 'closed';

            for (let i = 0; i < daysData.length; i++) {
                const parts = daysData[i].split(':');
                if (parts[0] === currentDayStr) {
                    daySchedule = parts[1];
                    break;
                }
            }

            if (daySchedule === 'closed' || !daySchedule.includes('-')) {
                badge.textContent = 'ZÁRVA';
                badge.className = 'tagkonyvtar-status-badge is-closed';
            } else {
                const timeParts = daySchedule.split('-');
                const startParts = timeParts[0].split(':');
                const endParts = timeParts[1].split(':');

                const startMin = parseInt(startParts[0], 10) * 60 + parseInt(startParts[1], 10);
                const endMin = parseInt(endParts[0], 10) * 60 + parseInt(endParts[1], 10);

                if (currentMin >= startMin && currentMin < endMin) {
                    badge.textContent = 'NYITVA';
                    badge.className = 'tagkonyvtar-status-badge is-open';
                } else {
                    badge.textContent = 'ZÁRVA';
                    badge.className = 'tagkonyvtar-status-badge is-closed';
                }
            }
        });
    </script>
{% endblock %}
