<article class="post-card">
    {% if post.thumbnail %}
        <a class="post-card__media" href="{{ post.link }}">
            <img src="{{ post.thumbnail.src('large') }}" alt="{{ post.thumbnail.alt ?: post.title }}">
        </a>
    {% endif %}
    <div class="post-card__meta">
        <span>{{ post.date('Y.m.d.') }}</span>
        {% if post.terms('category') %}
            <span>{{ post.terms('category')|first.name }}</span>
        {% endif %}
    </div>
    <h2><a href="{{ post.link }}">{{ post.title }}</a></h2>
    <p>{{ post.preview.length(26).read_more(false) }}</p>
    <a class="post-card__link" href="{{ post.link }}">Tovább</a>
</article>
