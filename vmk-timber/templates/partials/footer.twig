<footer class="site-footer" id="kapcsolat">
    <div class="container site-footer__top">
        <div class="footer-brand">
            <span class="brand__mark">VMK</span>
            <h2>{{ branding.title }}</h2>
            <p>{{ branding.tagline }}</p>
            <p>
                <svg width="14" height="14" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-2px"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                {{ footer.address }}
            </p>
            <a href="tel:{{ footer.phone|replace({' ': ''}) }}">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                {{ footer.phone }}
            </a>
            <a href="mailto:{{ footer.email }}">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                {{ footer.email }}
            </a>
            <div class="social-links social-links--footer" aria-label="Közösségi linkek">
                {% for item in footer.socials %}
                    <a href="{{ item.url }}" aria-label="{{ item.label }}" target="_blank" rel="noopener noreferrer" title="{{ item.label }}">
                        {{ item.label|slice(0,2)|upper }}
                    </a>
                {% endfor %}
            </div>
        </div>

        <div class="footer-links">
            <div>
                <h3>Rólunk</h3>
                <ul>
                    {% for item in menus.footer_about.items|default(menus.footer_about) %}
                        <li><a href="{{ item.link }}">{{ item.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            <div>
                <h3>Szolgáltatások</h3>
                <ul>
                    {% for item in menus.footer_services.items|default(menus.footer_services) %}
                        <li><a href="{{ item.link }}">{{ item.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            <div>
                <h3>Támogatás &amp; Közösség</h3>
                <ul>
                    {% for item in menus.footer_support.items|default(menus.footer_support) %}
                        <li><a href="{{ item.link }}">{{ item.title }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>

    <div class="container site-footer__bottom">
        <p>{{ footer.copyright }}</p>
        <p>
            <a href="/adatvedelem" style="color:rgba(255,255,255,0.45);font-size:0.82rem">Adatvédelmi nyilatkozat</a>
        </p>
    </div>
</footer>
