<header class="site-header" id="header">
    <div class="site-topbar">
        <div class="container site-topbar__inner">
            <div class="site-topbar__info">
                <a href="tel:{{ footer.phone|replace({' ': ''}) }}">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    {{ footer.phone }}
                </a>
                <a href="mailto:{{ footer.email }}">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    {{ footer.email }}
                </a>
                <span>
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {{ footer.hours }}
                </span>
            </div>
            <a class="site-topbar__link" href="{{ footer.catalog_url }}" target="_blank" rel="noopener">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                Online Katalógus
            </a>
        </div>
    </div>

    <div class="container site-header__inner">
        <a class="brand" href="{{ site.url }}">
            <img class="brand__logo-img" src="https://www.vmk.hu/assets/images/logo/logo.png" alt="VMK Logo" style="height: 42px; width: auto; object-fit: contain;">
        </a>

        <div class="site-header__actions">
            <nav class="site-nav" aria-label="Elsődleges navigáció">
                <ul>
                    {% for item in menus.primary.items|default(menus.primary) %}
                        <li>
                            <a href="{{ item.link }}"
                               {% if item.link == site.url or item.is_ancestor %}aria-current="page"{% endif %}>
                                {{ item.title }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            <div class="header-tools">
                <a class="header-cta" href="{{ footer.catalog_url }}" target="_blank" rel="noopener">
                    Beiratkozás
                </a>
                <div class="social-links social-links--header" aria-label="Közösségi linkek">
                    {% for item in footer.socials %}
                        <a href="{{ item.url }}" aria-label="{{ item.label }}" target="_blank" rel="noopener noreferrer" title="{{ item.label }}">
                            {{ item.label|slice(0,2)|upper }}
                        </a>
                    {% endfor %}
                </div>
            </div>

            <button class="menu-toggle" type="button"
                    aria-expanded="false"
                    aria-controls="site-mobile-menu"
                    data-menu-toggle>
                <span></span>
                <span></span>
                <span></span>
                <span class="screen-reader-text">Menü megnyitása</span>
            </button>
        </div>
    </div>

    <div class="site-mobile-menu" id="site-mobile-menu" hidden data-menu-panel>
        <div class="container site-mobile-menu__inner">
            <nav aria-label="Mobil navigáció">
                <ul>
                    {% for item in menus.primary.items|default(menus.primary) %}
                        <li><a href="{{ item.link }}">{{ item.title }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
            <a class="header-cta header-cta--mobile" href="{{ footer.catalog_url }}" target="_blank">Online Katalógus</a>
            <div class="site-mobile-menu__meta">
                <a href="tel:{{ footer.phone|replace({' ': ''}) }}">{{ footer.phone }}</a>
                <a href="mailto:{{ footer.email }}">{{ footer.email }}</a>
                <span style="font-size:0.82rem;color:var(--ink-soft)">{{ footer.hours }}</span>
            </div>
        </div>
    </div>
</header>
