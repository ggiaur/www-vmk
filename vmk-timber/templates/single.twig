{% extends 'templates/base.twig' %}

{% block content %}
    <section class="page-hero">
        <div class="container page-hero__inner">
            <span class="eyebrow">Bejegyzés</span>
            <h1>{{ post.title }}</h1>
            <p>{{ post.date('Y. m. d.') }}{% if post.author %} · {{ post.author.name }}{% endif %}</p>
        </div>
    </section>

    <section class="section content-section">
        <div class="container content-layout">
            <article class="content-card entry-content">
                {% if post.thumbnail %}
                    <figure class="entry-hero-media">
                        <img src="{{ post.thumbnail.src('large') }}" alt="{{ post.thumbnail.alt ?: post.title }}">
                    </figure>
                {% endif %}
                {{ post.content }}
            </article>
        </div>
    </section>

    {% if related_posts %}
        <section class="section related-section">
            <div class="container">
                <div class="section-heading">
                    <span class="eyebrow">További tartalmak</span>
                    <h2>Kapcsolódó hírek</h2>
                </div>
                <div class="post-grid">
                    {% for post in related_posts %}
                        {% include 'templates/partials/card-post.twig' with { post: post } %}
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}
{% endblock %}
