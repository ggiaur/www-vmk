{% extends 'templates/base.twig' %}

{% block content %}
    <section class="page-hero page-hero--compact">
        <div class="container page-hero__inner">
            <span class="eyebrow">Tartalmak</span>
            <h1>{{ theme.archive_title }}</h1>
            <p>{{ theme.archive_intro }}</p>
        </div>
    </section>

    <section class="section archive-section">
        <div class="container">
            {% if posts %}
                <div class="post-grid">
                    {% for post in posts %}
                        {% include 'templates/partials/card-post.twig' with { post: post } %}
                    {% endfor %}
                </div>
                {% include 'templates/partials/pagination.twig' with { pagination: pagination } %}
            {% else %}
                <div class="empty-state">
                    <h2>Nincs megjeleníthető tartalom</h2>
                    <p>Próbáld meg egy másik kulcsszóval, vagy nézd meg a főoldalt.</p>
                    {{ function('get_search_form') }}
                    <a class="button button--primary" href="{{ site.url }}">Vissza a főoldalra</a>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
