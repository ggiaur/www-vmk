# VMK Website Modernization Environment Variables

# Node & Server Settings
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16)
DATABASE_URI=postgres://vmk_user:vmk_password@localhost:5432/vmk_db

# Payload CMS Secret Key
PAYLOAD_SECRET=vmk_super_secret_payload_key_2026_dev

# Storage Configuration (MinIO S3 Object Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_BUCKET=vmk-media
MINIO_USE_SSL=false

# Instant Search (Meilisearch Engine)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=vmk_meili_master_key
